                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">Role You Are Hiring For</label>
                    <input type="text" required placeholder="e.g. Senior Full Stack Developer" class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 outline-none">
