          featured: true,
          description: "We are seeking a Senior Full Stack Engineer to join our decentralized product team. You will build high-concurrency microservices and responsive React interfaces.",
          requirements: ["5+ years experience with Node.js & React", "Proven track record in remote-first team environments", "Deep understanding of PostgreSQL and Redis"]
        },
        {
          id: 2,
          title: "Remote Growth Marketing Lead",
          company: "SaaS Scaleup",
          logo: "https://placehold.co/100x100/2563eb/ffffff?text=SaaS",
          category: "Marketing & Content",
          remoteType: "100% WFA",
          location: "Global / Worldwide",
          salary: "$85,000 - $105,000",
          type: "Full-Time",
          posted: "5 hours ago",
          featured: false,
          description: "Manage paid acquisition channels, organic SEO content loops, and lifecycle email automation to scale our SaaS customer base.",
          requirements: ["3+ years performance marketing experience", "Proficiency with Google Analytics 4, Mixpanel, and Meta Ads", "Excellent analytical and copywriting skills"]
        },
        {
          id: 3,
          title: "Customer Success Manager (EMEA Timezones)",
          company: "CloudFlow Systems",
          logo: "https://placehold.co/100x100/059669/ffffff?text=CFS",
          category: "Customer Support",
          remoteType: "WFH Regional",
          location: "Work From Home (EMEA Region)",
          salary: "$60,000 - $75,000",
          type: "Full-Time",
          posted: "1 day ago",
          featured: false,
          description: "Serve as the primary point of contact for mid-market enterprise accounts across Europe and Africa. Drive onboarding, feature adoption, and retention.",
          requirements: ["Fluency in English (German or French is a plus)", "2+ years in B2B SaaS account management", "Strong technical troubleshooting abilities"]
        },
        {
          id: 4,
          title: "Fractional Chief Marketing Officer (CMO)",
          company: "HIB Client Partners",
          logo: "https://placehold.co/100x100/7c3aed/ffffff?text=HIB",
          category: "Executive & Fractional",
          remoteType: "100% WFA",
          location: "Global / Worldwide",
          salary: "$120/hr - $150/hr",
          type: "Fractional / Contract",
          posted: "Just now",
          featured: true,
          description: "Directly headhunted by HIB Recruitment Services. High-growth Series A startup seeking a fractional CMO to drive strategic brand positioning.",
          requirements: ["Prior C-suite experience in tech startups", "Proven capability in building GTM frameworks", "10-15 hours per week availability"]
        },
        {
          id: 5,
          title: "DevOps & Infrastructure Architect",
          company: "Vercel Ecosystem",
          logo: "https://placehold.co/100x100/0f172a/ffffff?text=VER",
          category: "Software & Tech",
          remoteType: "WFH Regional",
          location: "Work From Home (US/Canada)",
          salary: "$130,000 - $160,000",
          type: "Full-Time",
          posted: "2 days ago",
          featured: false,
          description: "Maintain terraform deployments, Kubernetes clusters, and automated CI/CD deployment pipelines.",
          requirements: ["AWS Certified Solutions Architect", "Strong experience with Docker, K8s, and GitHub Actions", "On-call rotation availability"]
        }
      ];

      let currentJobs = [...sampleJobs];
      let activeRemoteFilter = 'all';

      // Render Job List
      function renderJobs(jobs) {
        const container = document.getElementById('jobsList');
        const countLabel = document.getElementById('jobCountLabel');
        
        countLabel.textContent = `Showing ${jobs.length} active remote role${jobs.length === 1 ? '' : 's'}`;

        if (jobs.length === 0) {
          container.innerHTML = `
            <div class="text-center py-12 bg-white rounded-2xl border border-slate-200">
              <i class="fa-solid fa-folder-open text-slate-300 text-4xl mb-3"></i>
              <h4 class="text-base font-bold text-slate-700">No matching remote jobs found</h4>
              <p class="text-xs text-slate-400 mt-1">Try adjusting your keyword search or remote filter options.</p>
            </div>
          `;
          return;
        }

        container.innerHTML = jobs.map(job => {
          let badgeStyle = 'badge-wfa';
          if (job.remoteType === 'WFH Regional') badgeStyle = 'badge-wfh';
          if (job.remoteType === 'Hybrid') badgeStyle = 'badge-hybrid';

          return `
            <div class="job-card bg-white rounded-2xl p-5 border ${job.featured ? 'border-blue-200 bg-blue-50/20' : 'border-slate-200'} flex flex-col md:flex-row items-start md:items-center justify-between gap-4 cursor-pointer" onclick="openJobModal(${job.id})">
              <div class="flex items-start gap-4">
                <img src="${job.logo}" alt="${job.company}" class="w-12 h-12 rounded-xl object-cover border border-slate-100 flex-shrink-0">
                <div>
                  <div class="flex flex-wrap items-center gap-2 mb-1">
                    <span class="text-xs font-bold text-slate-500">${job.company}</span>
                    ${job.featured ? '<span class="text-[10px] font-extrabold bg-blue-600 text-white px-2 py-0.5 rounded-md uppercase tracking-wider">Featured</span>' : ''}
                  </div>
                  <h3 class="text-base font-bold text-slate-900 leading-snug hover:text-blue-600 transition">${job.title}</h3>
                  <div class="flex flex-wrap items-center gap-x-4 gap-y-1 mt-2 text-xs text-slate-500 font-medium">
                    <span><i class="fa-solid fa-tag text-slate-400 mr-1"></i>${job.category}</span>
                    <span><i class="fa-solid fa-dollar-sign text-slate-400 mr-1"></i>${job.salary}</span>
                    <span><i class="fa-regular fa-clock text-slate-400 mr-1"></i>${job.posted}</span>
                  </div>
                </div>
              </div>

              <div class="flex flex-wrap md:flex-col items-start md:items-end justify-between w-full md:w-auto border-t md:border-t-0 pt-3 md:pt-0 border-slate-100 gap-2">
                <span class="text-xs font-semibold px-3 py-1 rounded-full ${badgeStyle}">
                  ${job.location}
                </span>
                <span class="text-xs font-bold text-blue-600 hover:underline flex items-center gap-1">
                  View Role <i class="fa-solid fa-arrow-right text-[10px]"></i>
                </span>
              </div>
            </div>
          `;
        }).join('');
      }

      // Filter Logic
      function filterJobs() {
        const searchTerm = document.getElementById('searchInput').value.toLowerCase();
        const selectedCategory = document.getElementById('categorySelect').value;

        const filtered = currentJobs.filter(job => {
          const matchesSearch = job.title.toLowerCase().includes(searchTerm) || 
                                job.company.toLowerCase().includes(searchTerm) ||
                                job.description.toLowerCase().includes(searchTerm);
          
          const matchesCategory = selectedCategory === 'all' || job.category === selectedCategory;
          
          const matchesRemote = activeRemoteFilter === 'all' || 
                                (activeRemoteFilter === '100% WFA' && job.remoteType === '100% WFA') ||
                                (activeRemoteFilter === 'WFH Regional' && job.remoteType === 'WFH Regional') ||
                                (activeRemoteFilter === 'Hybrid' && job.remoteType === 'Hybrid');

          return matchesSearch && matchesCategory && matchesRemote;
        });

        renderJobs(filtered);
      }

      function setRemoteFilter(filterType) {
        activeRemoteFilter = filterType;
        document.querySelectorAll('.filter-pill').forEach(btn => {
          btn.classList.remove('bg-blue-600', 'text-white');
          btn.classList.add('bg-slate-100', 'text-slate-600');
        });
        event.target.classList.remove('bg-slate-100', 'text-slate-600');
        event.target.classList.add('bg-blue-600', 'text-white');
        filterJobs();
      }

      // Event Listeners
      document.getElementById('searchInput').addEventListener('input', filterJobs);
      document.getElementById('categorySelect').addEventListener('change', filterJobs);

      // Modal Handling
      function openJobModal(id) {
        const job = currentJobs.find(j => j.id === id);
        if (!job) return;

        const modalContent = document.getElementById('modalContent');
        modalContent.innerHTML = `
          <div class="flex items-center gap-4 mb-4">
            <img src="${job.logo}" class="w-14 h-14 rounded-xl border border-slate-200">
