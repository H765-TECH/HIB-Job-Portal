              <span class="text-xs font-semibold text-blue-600">${job.location} • ${job.salary}</span>
            </div>
          </div>
          
          <div class="border-t border-b border-slate-100 py-4 my-4 space-y-3">
            <h4 class="text-sm font-bold text-slate-800">Job Overview</h4>
            <p class="text-sm text-slate-600 leading-relaxed">${job.description}</p>
            
            <h4 class="text-sm font-bold text-slate-800 pt-2">Requirements</h4>
            <ul class="list-disc list-inside text-sm text-slate-600 space-y-1">
              ${job.requirements.map(req => `<li>${req}</li>`).join('')}
            </ul>
          </div>

          <div class="bg-blue-50 p-4 rounded-xl border border-blue-100 mb-6 flex items-center justify-between">
            <div class="text-xs text-blue-900">
              <span class="font-bold block">Recruitment Verification</span>
              Verified role listed via HIB Recruitment Services portal.
            </div>
            <button onclick="applyJob('${job.title}')" class="bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-5 py-2.5 rounded-xl transition shadow-md shadow-blue-500/20">
              Apply Now
            </button>
          </div>
        `;

        document.getElementById('jobModal').classList.remove('hidden');
      }

      function closeJobModal() {
        document.getElementById('jobModal').classList.add('hidden');
      }

      function applyJob(title) {
        closeJobModal();
        showToast(`Redirecting to application form for ${title}...`);
      }

      function toggleAiModal() {
        const modal = document.getElementById('aiModal');
        modal.classList.toggle('hidden');
      }

      function openConsultationModal() {
        document.getElementById('consultationModal').classList.remove('hidden');
      }

      function closeConsultationModal() {
        document.getElementById('consultationModal').classList.add('hidden');
      }

      function handleAgencyLeadSubmit(e) {
        e.preventDefault();
        closeConsultationModal();
        showToast("Request submitted! HIB Recruitment will reach out within 2 hours.");
      }

      function handleSubscribe(e) {
        e.preventDefault();
        document.getElementById('subscriberEmail').value = '';
        showToast("Subscribed! You will receive weekly remote job digests.");
      }

      function triggerSimulatedImport() {
        showToast("🤖 AI Pipeline: Fetching & publishing 2 new WFA remote jobs...");
        setTimeout(() => {
          const newJob = {
            id: Date.now(),
            title: "Senior AI & Data Engineer (Python)",
            company: "OpenAI Ecosystem Partner",
            logo: "https://placehold.co/100x100/10a37f/ffffff?text=AI",
            category: "Software & Tech",
            remoteType: "100% WFA",
