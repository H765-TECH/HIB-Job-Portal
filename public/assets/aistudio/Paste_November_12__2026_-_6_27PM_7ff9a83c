        <span id="toastMsg" class="text-xs font-medium">Action successful!</span>
    </div>

    <!-- JavaScript Data & Logic -->
    <script>
      // Initial Job Database Seed
      const sampleJobs = [
        {
          id: 1,
          title: "Senior Full Stack Engineer (Node + React)",
          company: "Gitlab Ecosystem",
          logo: "https://placehold.co/100x100/1e293b/ffffff?text=GIT",
          category: "Software & Tech",
          remoteType: "100% WFA",
          location: "Global / Worldwide",
          salary: "$110,000 - $140,000",
          type: "Full-Time",
